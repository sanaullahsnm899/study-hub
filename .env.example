# ---------------------------------------------------------------------------
# StudyHub environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres, Neon, or any Postgres 14+) ---------------
# Supabase: Project settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres:password@localhost:5432/studyhub

# --- Authentication --------------------------------------------------------
# Random secret used to sign the admin session cookie (min 32 chars).
# Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Used once by `npm run db:seed` / `npm run admin:create` to create the admin.
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Class Representative

# --- Branding / site -------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=StudyHub
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- File storage ----------------------------------------------------------
# Leave STORAGE_PROVIDER empty to auto-select: Google Drive when configured,
# otherwise the local filesystem (development only — Vercel disks are ephemeral).
# STORAGE_PROVIDER=google_drive
MAX_UPLOAD_MB=50

# --- Google Drive (production storage) -------------------------------------
# 1. Google Cloud console → new project → enable "Google Drive API"
# 2. Create a service account → Keys → Add key → JSON
# 3. In Google Drive, create the "Study Materials" folder and share it with the
#    service-account email as Editor. Copy the folder id from its URL.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=studyhub@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# Only when the folder lives in a Shared Drive:
# GOOGLE_SHARED_DRIVE_ID=
# Only when using domain-wide delegation with Google Workspace:
# GOOGLE_IMPERSONATE_SUBJECT=you@your-university.edu
